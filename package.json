{
  "name": "christmas-date-app",
  "version": "1.0.0",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@pixiv/three-vrm": "^3.4.4",
    "@react-three/fiber": "^9.4.2",
    "@supabase/supabase-js": "^2.89.0",
    "expo": "~54.0.30",
    "expo-gl": "~16.0.9",
    "expo-location": "^19.0.8",
    "expo-router": "^6.0.21",
    "expo-sensors": "^15.0.8",
    "expo-status-bar": "~3.0.9",
    "expo-three": "^8.0.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-web": "^0.21.2",
    "three": "^0.182.0"
  },
  "devDependencies": {
    "@testing-library/react-native": "^13.3.0",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.1.0",
    "@types/three": "^0.182.0",
    "jest": "^29.7.0",
    "jest-expo": "~53.0.5",
    "react-test-renderer": "19.1.0",
    "ts-jest": "^29.4.6",
    "typescript": "~5.9.2"
  },
  "jest": {
    "testEnvironment": "node",
    "transform": {
      "^.+\\.(ts|tsx)$": [
        "ts-jest",
        {
          "tsconfig": "tsconfig.json"
        }
      ]
    },
    "setupFilesAfterEnv": [
      "<rootDir>/__tests__/setup.ts"
    ],
    "testMatch": [
      "**/__tests__/**/*.test.ts",
      "**/__tests__/**/*.test.tsx"
    ],
    "modulePathIgnorePatterns": [
      "<rootDir>/__tests__/setup.ts"
    ],
    "moduleFileExtensions": [
      "ts",
      "tsx",
      "js",
      "jsx",
      "json"
    ]
  },
  "private": true
}
